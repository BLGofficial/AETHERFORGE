{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "contracts/src/**/*.ts",
    "contracts/scripts/**/*.ts",
    "contracts/tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "adapters/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "services/*/src/**/*.ts",
    "workers/*/src/**/*.ts",
    "plugins/*/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/*/src/**/*.ts",
    "SPECIFICATION_SCHEMAS/**/*.ts",
    "SYSTEM_COMPILER/**/*.ts",
    "COMPILER_TESTS/**/*.ts",
    "WORKFLOW_SCHEMA/**/*.ts",
    "WORKFLOW_ENGINE/**/*.ts",
    "ORCHESTRATION_ENGINE/**/*.ts",
    "WORKFLOW_TESTS/**/*.ts",
    "TOOL_GATEWAY/**/*.ts",
    "EXECUTION_ADAPTERS/**/*.ts",
    "PERMISSION_SYSTEM/**/*.ts",
    "ARTIFACT_MANAGER/**/*.ts",
    "EXECUTION_AUDIT/**/*.ts",
    "ENGINEERING_RUNTIME/**/*.ts",
    "DSP_ENGINE/**/*.ts",
    "VST3_ENGINE/**/*.ts",
    "DAW_ADAPTER_FRAMEWORK/**/*.ts",
    "AUDIO_TEST_FRAMEWORK/**/*.ts",
    "KNOWLEDGE_ENGINE/**/*.ts",
    "MEMORY_ENGINE/**/*.ts",
    "DOCUMENT_INGESTION/**/*.ts",
    "RETRIEVAL_ENGINE/**/*.ts",
    "PROJECT_CONTEXT_ENGINE/**/*.ts",
    "EVIDENCE_REGISTRY/**/*.ts",
    "VERIFICATION_ENGINE/**/*.ts",
    "QA_FRAMEWORK/**/*.ts",
    "DESIGN_SYSTEM/**/*.ts",
    "COMPONENT_LIBRARY/**/*.ts",
    "API_INTEGRATION/**/*.ts",
    "FRONTEND_APPLICATION/**/*.ts",
    "E2E_UI_TESTS/**/*.ts",
    "products/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "target",
    "dist",
    ".aetherforge"
  ]
}
