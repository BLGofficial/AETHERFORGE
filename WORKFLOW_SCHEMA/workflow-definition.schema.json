{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherforge.internal/schemas/v1/workflow-definition.schema.json",
  "title": "AETHER FORGE Durable Workflow Definition & Checkpoint Schema (v1.0.0)",
  "type": "object",
  "required": [
    "schemaVersion",
    "workflowId",
    "name",
    "version",
    "tenantId",
    "projectId",
    "inputContractSchemaId",
    "outputContractSchemaId",
    "preconditions",
    "budget",
    "steps",
    "completionConditions",
    "evidenceRequirements"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "workflowId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tenantId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "inputContractSchemaId": { "type": "string", "minLength": 1 },
    "outputContractSchemaId": { "type": "string", "minLength": 1 },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["preconditionId", "description", "requiredContextKey"],
        "properties": {
          "preconditionId": { "type": "string" },
          "description": { "type": "string" },
          "requiredContextKey": { "type": "string" },
          "expectedValue": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": ["maxTotalTokens", "maxTotalCostUsd", "maxDurationMs", "maxSteps"],
      "properties": {
        "maxTotalTokens": { "type": "integer", "minimum": 1 },
        "maxTotalCostUsd": { "type": "number", "exclusiveMinimum": 0 },
        "maxDurationMs": { "type": "integer", "minimum": 1 },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stepId",
          "title",
          "kind",
          "responsibleAgentId",
          "actionTier",
          "requiredTools",
          "completionCondition",
          "evidenceRequirements"
        ],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "SEQUENTIAL_TASK",
              "PARALLEL_GROUP",
              "CONDITIONAL_BRANCH",
              "NESTED_WORKFLOW",
              "HUMAN_APPROVAL_GATE",
              "INDEPENDENT_VERIFICATION_GATE"
            ]
          },
          "responsibleAgentId": {
            "type": "string",
            "enum": [
              "AGT-01", "AGT-02", "AGT-03", "AGT-04", "AGT-05",
              "AGT-06", "AGT-07", "AGT-08", "AGT-09", "AGT-10",
              "AGT-11", "AGT-12", "AGT-13", "AGT-14", "AGT-15",
              "AGT-16", "AGT-17", "AGT-18", "AGT-19"
            ]
          },
          "actionTier": { "type": "string", "enum": ["0", "1", "2", "3"] },
          "requiredTools": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "exclusiveWriteGlobs": { "type": "array", "items": { "type": "string" } },
          "readOnlyGlobs": { "type": "array", "items": { "type": "string" } },
          "dependsOnStepIds": { "type": "array", "items": { "type": "string" } },
          "timeoutMs": { "type": "integer", "minimum": 1 },
          "estimatedTokens": { "type": "integer", "minimum": 0 },
          "estimatedCostUsd": { "type": "number", "minimum": 0 },
          "completionCondition": { "type": "string", "minLength": 1 },
          "evidenceRequirements": { "type": "array", "minItems": 1, "items": { "type": "object" } }
        }
      }
    },
    "completionConditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceRequirements": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "additionalProperties": false
}
