{
  "name": "aether-forge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AETHER FORGE — Governed hybrid engineering and audio-production platform",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types ./apps/web/src/dev-server.ts",
    "build": "tsc -p tsconfig.json --noEmit && node --experimental-strip-types ./contracts/scripts/generate-schemas.ts && node --experimental-strip-types ./scripts/verify-native-toolchains.ts && node --experimental-strip-types ./scripts/generate-release-candidate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schemas:generate": "node --experimental-strip-types ./contracts/scripts/generate-schemas.ts",
    "native:build": "node --experimental-strip-types ./scripts/verify-native-toolchains.ts",
    "rc:generate": "node --experimental-strip-types ./scripts/generate-release-candidate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  }
}
